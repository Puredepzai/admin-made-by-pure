            torso.CanCollide = false
            torso.Massless = true
            if config.hitboxColor then
                torso.Color = config.hitboxColor
            else
                torso.Color = Color3.fromRGB(255, 255, 255)
            end
        end)
        if config.hitboxVisualizer.enabled then
            updateproxyhb(targetPlayer)
