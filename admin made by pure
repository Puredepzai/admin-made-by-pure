    config.originalSizes[targetPlayer] = nil
    config.targethbSizes[targetPlayer] = nil
    config.centerLocked[targetPlayer] = nil
    if config._selectedPartForTarget then
        config._selectedPartForTarget[targetPlayer] = nil
