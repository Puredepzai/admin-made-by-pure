local function getgist_(url, how, sigma)
    how = how or 10
    sigma = sigma or 1
    local attempts = 0
    local dat1error = nil
    while attempts < how do
        local success, result = xpcall(function()
            return game:HttpGet(url)
        end, function(err)
            return debug.traceback("[getgist_] " .. tostring(err), 2)
        end)
        if success then
            return result
        else
            attempts = attempts + 1
            dat1error = result
            if string.find(tostring(result), "429") or string.find(tostring(result), "Too many Requests") then
                local waitTime = sigma * (2 ^ (attempts - 1))
                warn("http 429: " .. waitTime .. " seconds... (Attempt " .. attempts .. "/" .. how .. ")")
                task.wait(waitTime)
            else
                warn("http error: " .. tostring(result) .. ". Retrying in " .. sigma .. " seconds... (Attempt " .. attempts .. "/" .. how .. ")")
                task.wait(sigma)
            end
        end
    end
    warn("[Pure]: can't get url :( after " .. how .. " attempts: " .. tostring(dat1error))
end

