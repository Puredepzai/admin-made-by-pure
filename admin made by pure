    }) do
        local S = {fly = false, flySpeed = 60, infJump = false, antiVoid = false, spin = false}
        config.varibz.pureMove = S
        local function hrp()
            local c = LocalPlayer.Character
            return c and c:FindFirstChild("HumanoidRootPart"), c and c:FindFirstChildOfClass("Humanoid")
        end
        local flyBV, flyBG, flyConn
        local function stopFly()
            if flyConn then flyConn:Disconnect() flyConn = nil end
            if flyBV then flyBV:Destroy() flyBV = nil end
            if flyBG then flyBG:Destroy() flyBG = nil end
            local _, hum = hrp()
            if hum then hum.PlatformStand = false end
        end
        local function startFly()
            stopFly()
            local root, hum = hrp()
            if not root or not hum then return end
            hum.PlatformStand = true
            flyBV = Instance.new("BodyVelocity")
            flyBV.MaxForce = Vector3.new(1e6, 1e6, 1e6)
            flyBV.Velocity = Vector3.zero
            flyBV.Parent = root
            flyBG = Instance.new("BodyGyro")
            flyBG.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
            flyBG.P = 9000
            flyBG.Parent = root
            flyConn = RunService.RenderStepped:Connect(function()
                local r, h = hrp()
                if not r or not h or not S.fly then return stopFly() end
                local cam = workspace.CurrentCamera
                local dir = h.MoveDirection
                local vel = Vector3.zero
                if dir.Magnitude > 0 then
                    -- move toward where the camera looks (works with the mobile joystick)
                    local look = cam.CFrame.LookVector
                    local right = cam.CFrame.RightVector
                    local fwd = dir:Dot(Vector3.new(look.X, 0, look.Z).Unit)
                    local side = dir:Dot(Vector3.new(right.X, 0, right.Z).Unit)
                    vel = (look * fwd + right * side) * S.flySpeed
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vel = vel + Vector3.new(0, S.flySpeed, 0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then vel = vel - Vector3.new(0, S.flySpeed, 0) end
                flyBV.Velocity = vel
                flyBG.CFrame = cam.CFrame
            end)
        end
        MoveTab:Paragraph({Title = "Fly", Desc = "joystick = move where camera looks, jump = up", Color = config.Gradow.uicolor.lightGreen})
        MoveTab:Toggle({Title = "Fly", Desc = "toggle flight", Value = false, Callback = function(v)
            S.fly = v
            if v then startFly() else stopFly() end
        end})
        MoveTab:Slider({Title = "Fly Speed", Desc = "studs/sec", Step = 5, Value = {Min = 10, Max = 300, Default = 60}, Callback = function(v) S.flySpeed = v end})
