-- // NEW FEATURES - ESP LOS (Line of Sight)
-- ==========================================
local LOSParts = {}
local function updateESP_LOS()
    if not config.ESPEnabled or not config.LOSEnabled then
        for _, part in pairs(LOSParts) do
            if part then part:Destroy() end
        end
        LOSParts = {}
        return
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local isTeammate = player.Team ~= nil and player.Team == LocalPlayer.Team
            local hasAliveHum = char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0
            local showLOS = hasAliveHum
            if config.LOSTeamCheck and isTeammate then showLOS = false end
            if showLOS then
                local head = char:FindFirstChild("Head")
                if head then
                    local part = LOSParts[player]
                    if not part then
                        part = Instance.new("Part")
                        part.Anchored = true
                        part.CanCollide = false
                        part.CastShadow = false
                        part.Material = Enum.Material.Neon
                        part.Parent = workspace
                        LOSParts[player] = part
                    end
                    local origin = head.Position
                    local destination = origin + (head.CFrame.LookVector * config.LOSLength)
                    local dist = config.LOSLength
                    part.Size = Vector3.new(config.LOSWidth / 10, config.LOSWidth / 10, dist)
                    part.CFrame = CFrame.lookAt(origin, destination) * CFrame.new(0, 0, -dist / 2)
                    part.Color = config.LOSColor
                    part.Transparency = 0.3
                end
            else
                if LOSParts[player] then LOSParts[player].Transparency = 1 end
            end
        end
    end
end

-- ==========================================
-- // ANTI-FLING
-- ==========================================
local function antiFlingUpdate()
    if not config.AntiFling then return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            for _, part in ipairs(player.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                    part.Velocity = Vector3.new(0, 0, 0)
                    part.RotVelocity = Vector3.new(0, 0, 0)
                end
            end
        end
    end
end

